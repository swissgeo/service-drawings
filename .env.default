
# used for local development
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=123
AWS_SECRET_ACCESS_KEY=123
AWS_ENDPOINT_URL=http://localhost:5000
AWS_S3_BUCKET_NAME=service-drawings-local
AWS_S3_ENDPOINT_URL=http://localhost:5000
AWS_CLOUDFRONT_DOMAIN=http://localhost:5000
PUBLISH_OPENAPI_SPEC=1

CORS_ORIGIN_REGEX=http://localhost:\\d+

# moto server port and endpoint for local AWS service emulation (S3)
# MOTO_PORT is used by docker-compose to expose the container port
MOTO_PORT=5000

# OTEL configuration
OTEL_SDK_DISABLE=true
OTEL_PYTHON_EXCLUDED_URLS=/checker
OTEL_ENABLE_OTLP_EXPORTER=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true

# Metric exporter config
OTEL_ENABLE_METRICS=true
OTEL_METRIC_EXPORT_INTERVAL=10000
OTEL_METRIC_EXPORT_TIMEOUT=3000

# Logging configuration
LOGGING_ENABLE_DEV_SERVER_LOGGING=true
LOGGING_CONFIG_FILE=./logging-local-config.yaml

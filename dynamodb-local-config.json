{
    "TableName": "${AWS_DYNAMODB_TABLE_NAME}",
    "BillingMode": "PAY_PER_REQUEST",
    "AttributeDefinitions": [
        {
            "AttributeName": "id",
            "AttributeType": "S"
        },
        {
            "AttributeName": "major_version",
            "AttributeType": "N"
        },
        {
            "AttributeName": "created",
            "AttributeType": "S"
        }
    ],
    "KeySchema": [
        {
            "AttributeName": "id",
            "KeyType": "HASH"
        }
    ],
    "GlobalSecondaryIndexes": [
        {
            "IndexName": "VersionIndex",
            "KeySchema": [
                {
                    "AttributeName": "major_version",
                    "KeyType": "HASH"
                },
                {
                    "AttributeName": "id",
                    "KeyType": "RANGE"
                }
            ],
            "Projection": {
                "ProjectionType": "KEYS_ONLY"
            }
        },
        {
            "IndexName": "CreatedIndex",
            "KeySchema": [
                {
                    "AttributeName": "created",
                    "KeyType": "HASH"
                },
                {
                    "AttributeName": "id",
                    "KeyType": "RANGE"
                }
            ],
            "Projection": {
                "ProjectionType": "INCLUDE",
                "NonKeyAttributes": [
                    "last_accessed"
                ]
            }
        }
    ]
}
